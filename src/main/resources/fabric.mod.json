{
  "schemaVersion": 1,
  "id": "skycrypt-pv",
  "version": "${version}",
  "name": "SkyCrypt PV",
  "description": "/pv opens SkyCrypt in-game, like Lunar's /pv. Powered by SkyCrypt. Unofficial, not affiliated with SkyCrypt or Hypixel.",
  "authors": ["HabaneroTactic"],
  "contributors": ["SkyCrypt team (sky.shiiyu.moe)", "DimasKama (MCEF Modern)"],
  "contact": {
    "homepage": "https://github.com/HabaneroTactic/SkyCryptPV",
    "sources": "https://github.com/HabaneroTactic/SkyCryptPV",
    "issues": "https://github.com/HabaneroTactic/SkyCryptPV/issues"
  },
  "license": "LicenseRef-All-Rights-Reserved",
  "icon": "assets/skycrypt-pv/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.habanerotactic.skycryptpv.SkyCryptPV"],
    "modmenu": ["io.github.habanerotactic.skycryptpv.ModMenuIntegration"]
  },
  "mixins": ["skycrypt-pv.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-api": ">=${fabric_version}",
    "mcef-modern": "*"
